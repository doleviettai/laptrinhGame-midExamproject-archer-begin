    "sections":  [
                     {
                         "label":  "01 | KHỞI TẠO",
                         "description":  "On Start đặt health = 7, isAttacking = False, isHurt = False. Các biến đều thuộc Object trên Golem Blue.",
                         "position":  {
                                          "xMin":  0,
                                          "yMin":  0,
                                          "xMax":  1500,
                                          "yMax":  650
                                      }
                     },
                     {
                         "label":  "02 | PHÁT HIỆN PLAYER",
                         "description":  "On Became Visible → đặt Object isAwake = True. Sự kiện cũng có thể được kích hoạt bởi camera Scene view trong Editor.",
                         "position":  {
                                          "xMin":  1700,
                                          "yMin":  0,
                                          "xMax":  2800,
                                          "yMax":  650
                                      }
                     },
                     {
                         "label":  "03 | HƯỚNG VÀ KHOẢNG CÁCH",
                         "description":  "Data dùng chung: deltaX = Player.position.x − This.position.x. deltaX \u003e 0: Player bên phải. Abs(deltaX) ≤ attackRange: trong tầm ngang. Kết quả cấp cho nhóm 04, 05 và 07.",
                         "position":  {
                                          "xMin":  3000,
                                          "yMin":  0,
                                          "xMax":  6300,
                                          "yMax":  850
                                      }
                     },
                     {
                         "label":  "04 | CHỌN HÀNH VI",
                         "description":  "On Update → If isAwake → If isHurt. Hurt=True: nhóm 08. Hurt=False: kiểm tra tầm đánh; ngoài tầm → nhóm 05, trong tầm → nhóm 06.",
                         "position":  {
                                          "xMin":  0,
                                          "yMin":  1100,
                                          "xMax":  1500,
                                          "yMax":  1900
                                      }
                     },
                     {
                         "label":  "05 | ĐUỔI VÀ QUAY MẶT",
                         "description":  "If deltaX \u003e 0: vận tốc X = moveSpeed, Flip X=False, isWalk=True. Nhánh còn lại: vận tốc X = moveSpeed × −1, Flip X=True, isWalk=True. Giữ nguyên vận tốc Y.",
                         "position":  {
                                          "xMin":  1700,
                                          "yMin":  1100,
                                          "xMax":  3700,
                                          "yMax":  1980
                                      }
                     },
                     {
                         "label":  "06 | BẮT ĐẦU ĐÒN ĐÁNH",
                         "description":  "Trong tầm: dừng X, isWalk=False. If isAttacking=False → đặt True → Animator doAttack → Timer attackDelay. If isAttacking=True: không khởi động lại đòn.",
                         "position":  {
                                          "xMin":  3900,
                                          "yMin":  1100,
                                          "xMax":  6300,
                                          "yMax":  1980
                                      }
                     },
                     {
                         "label":  "07 | GÂY SÁT THƯƠNG VÀ NGHỈ",
                         "description":  "Timer ra đòn Completed → kiểm tra lại tầm ngang. True: gửi PlayerTakeDamage đến Player. False: đánh hụt. Cả hai đi vào Timer attackRecovery → isAttacking=False để được đánh tiếp.",
                         "position":  {
                                          "xMin":  3900,
                                          "yMin":  2180,
                                          "xMax":  6300,
                                          "yMax":  3000
                                      }
                     },
                     {
                         "label":  "08 | DỪNG TRONG LÚC HURT",
                         "description":  "Nhánh isHurt=True từ nhóm 04: vận tốc X=0, Animator isWalk=False. Chờ nhóm 11 đặt lại isHurt=False để tiếp tục hành vi.",
                         "position":  {
                                          "xMin":  0,
                                          "yMin":  2180,
                                          "xMax":  1500,
                                          "yMax":  2780
                                      }
                     },
                     {
                         "label":  "09 | NHẬN ARROW VÀ LỌC TAG",
                         "description":  "On Trigger Enter 2D → lấy GameObject từ Collider → Compare Tag PlayerArrow → If đúng tag → If health \u003e 0. Chỉ nhánh True chuyển sang nhóm 10.",
                         "position":  {
                                          "xMin":  0,
                                          "yMin":  3200,
                                          "xMax":  1800,
                                          "yMax":  4100
                                      }
                     },
                     {
                         "label":  "10 | TRỪ MÁU VÀ RẼ NHÁNH",
                         "description":  "Hủy GameObject Arrow (T=0) → health = health − Integer 1 → kiểm tra Value vừa lưu \u003e 0. True → nhóm 11 Hurt. False → nhóm 12 chết.",
                         "position":  {
                                          "xMin":  2000,
                                          "yMin":  3200,
                                          "xMax":  3600,
                                          "yMax":  4100
                                      }
                     },
                     {
                         "label":  "11 | HURT VÀ HỒI PHỤC",
                         "description":  "Còn máu: Object isHurt=True → Animator Trigger gotHit → Timer 0.36 giây → isHurt=False. Nhóm 08 dừng chạy trong thời gian này.",
                         "position":  {
                                          "xMin":  3800,
                                          "yMin":  3200,
                                          "xMax":  6300,
                                          "yMax":  4100
                                      }
                     },
                     {
                         "label":  "12 | CHẾT VÀ HỦY GOLEM",
                         "description":  "Hết máu: doDie → vận tốc (0,0) → Gravity=0 → tắt BoxCollider2D → Destroy This sau 0.85 giây → tắt ScriptMachine. Animator vẫn phát animation chết trong thời gian chờ.",
                         "position":  {
                                          "xMin":  2000,
                                          "yMin":  4300,
                                          "xMax":  6300,
                                          "yMax":  5100
                                      }
                     }
                 ],
