-5c9e1c9b8da3","$type":"Unity.VisualScripting.ValueConnection"},{"sourceUnit":{"$ref":"199"},"sourceKey":"self","destinationUnit":{"$ref":"56"},"destinationKey":"%obj","guid":"f4d4dd16-d510-418d-be61-487c8968994d","$type":"Unity.VisualScripting.ValueConnection"},{"position":{"xMin":0,"yMin":0,"xMax":1500,"yMax":650},"label":"01 | KHỞI TẠO","comment":"On Start đặt health = 7, isAttacking = False, isHurt = False. Các biến đều thuộc Object trên Golem Blue.","color":{"r":0.13,"g":0.3,"b":0.2,"a":1},"guid":"17f63b1c-4fd0-4b82-9fdb-879e2612cea8","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":1700,"yMin":0,"xMax":2800,"yMax":650},"label":"02 | PHÁT HIỆN PLAYER","comment":"On Became Visible → đặt Object isAwake = True. Sự kiện cũng có thể được kích hoạt bởi camera Scene view trong Editor.","color":{"r":0.1,"g":0.29,"b":0.31,"a":1},"guid":"c0a4eb2b-f566-46ae-99dc-1bf842df89a0","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":3000,"yMin":0,"xMax":6300,"yMax":850},"label":"03 | HƯỚNG VÀ KHOẢNG CÁCH","comment":"Data dùng chung: deltaX = Player.position.x − This.position.x. deltaX \u003e 0: Player bên phải. Abs(deltaX) ≤ attackRange: trong tầm ngang. Kết quả cấp cho nhóm 04, 05 và 07.","color":{"r":0.1,"g":0.23,"b":0.36,"a":1},"guid":"6925b5d7-f76e-4071-95cf-50c4176cde80","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":0,"yMin":1100,"xMax":1500,"yMax":1900},"label":"04 | CHỌN HÀNH VI","comment":"On Update → If isAwake → If isHurt. Hurt=True: nhóm 08. Hurt=False: kiểm tra tầm đánh; ngoài tầm → nhóm 05, trong tầm → nhóm 06.","color":{"r":0.18,"g":0.25,"b":0.35,"a":1},"guid":"9c80d1b9-47ed-4896-955c-5f18f788e9d1","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":1700,"yMin":1100,"xMax":3700,"yMax":1980},"label":"05 | ĐUỔI VÀ QUAY MẶT","comment":"If deltaX \u003e 0: vận tốc X = moveSpeed, Flip X=False, isWalk=True. Nhánh còn lại: vận tốc X = moveSpeed × −1, Flip X=True, isWalk=True. Giữ nguyên vận tốc Y.","color":{"r":0.1,"g":0.31,"b":0.22,"a":1},"guid":"92cef296-bbd4-45c0-a17d-b7fbd7e3302e","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":3900,"yMin":1100,"xMax":6300,"yMax":1980},"label":"06 | BẮT ĐẦU ĐÒN ĐÁNH","comment":"Trong tầm: dừng X, isWalk=False. If isAttacking=False → đặt True → Animator doAttack → Timer attackDelay. If isAttacking=True: không khởi động lại đòn.","color":{"r":0.35,"g":0.24,"b":0.08,"a":1},"guid":"9c8d3446-a862-44ca-998d-4c87122408a9","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":3900,"yMin":2180,"xMax":6300,"yMax":3000},"label":"07 | GÂY SÁT THƯƠNG VÀ NGHỈ","comment":"Timer ra đòn Completed → kiểm tra lại tầm ngang. True: gửi PlayerTakeDamage đến Player. False: đánh hụt. Cả hai đi vào Timer attackRecovery → isAttacking=False để được đánh tiếp.","color":{"r":0.36,"g":0.17,"b":0.08,"a":1},"guid":"5ff3500e-2715-49b0-840e-d0c764e79cff","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":0,"yMin":2180,"xMax":1500,"yMax":2780},"label":"08 | DỪNG TRONG LÚC HURT","comment":"Nhánh isHurt=True từ nhóm 04: vận tốc X=0, Animator isWalk=False. Chờ nhóm 11 đặt lại isHurt=False để tiếp tục hành vi.","color":{"r":0.28,"g":0.12,"b":0.3,"a":1},"guid":"e0ac6954-e99c-4058-aa35-75ac507ad2a9","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":0,"yMin":3200,"xMax":1800,"yMax":4100},"label":"09 | NHẬN ARROW VÀ LỌC TAG","comment":"On Trigger Enter 2D → lấy GameObject từ Collider → Compare Tag PlayerArrow → If đúng tag → If health \u003e 0. Chỉ nhánh True chuyển sang nhóm 10.","color":{"r":0.34,"g":0.13,"b":0.17,"a":1},"guid":"48bad1cc-19c4-42bb-b692-70769c4204f7","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":2000,"yMin":3200,"xMax":3600,"yMax":4100},"label":"10 | TRỪ MÁU VÀ RẼ NHÁNH","comment":"Hủy GameObject Arrow (T=0) → health = health − Integer 1 → kiểm tra Value vừa lưu \u003e 0. True → nhóm 11 Hurt. False → nhóm 12 chết.","color":{"r":0.36,"g":0.11,"b":0.13,"a":1},"guid":"f02a55cc-e54b-445a-8f25-dceff349cbc3","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":3800,"yMin":3200,"xMax":6300,"yMax":4100},"label":"11 | HURT VÀ HỒI PHỤC","comment":"Còn máu: Object isHurt=True → Animator Trigger gotHit → Timer 0.36 giây → isHurt=False. Nhóm 08 dừng chạy trong thời gian này.","color":{"r":0.28,"g":0.12,"b":0.3,"a":1},"guid":"ae39727b-d0a6-4805-b599-8e464537addf","$version":"A","$type":"Unity.VisualScripting.GraphGroup"},{"position":{"xMin":2000,"yMin":4300,"xMax":6300,"yMax":5100},"label":"12 | CHẾT VÀ HỦY GOLEM","comment":"Hết máu: doDie → vận tốc (0,0) → Gravity=0 → tắt BoxCollider2D → Destroy This sau 0.85 giây → tắt ScriptMachine. Animator vẫn phát animation chết trong thời gian chờ.","color":{"r":0.25,"g":0.13,"b":0.13,"a":1},"guid":"7bb648f6-f562-493b-98c2-ec72064e6c39","$version":"A","$type":"Unity.VisualScripting.GraphGroup"}],"$version":"A"}}'
